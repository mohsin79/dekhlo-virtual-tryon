# Inngest — server-only background jobs for merchant try-on generation and retention cleanup.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=
INNGEST_DEV=1
# INNGEST_SERVE_ORIGIN=https://your-production-domain.example

# OpenAI — used by the /api/try-on route to generate the style preview.
OPENAI_API_KEY=sk-...

# Chat orchestrator — defaults to gpt-5.6 (no org verification needed).
# After verifying your org, gpt-4.1-mini is cheaper/faster for orchestration.
OPENAI_CHAT_MODEL=gpt-5.6

# Image output quality: low | medium | high | auto (medium ≈ best value, high ≈ ChatGPT default).
OPENAI_IMAGE_QUALITY=medium

# Vision detail for uploads: low saves tokens; high only if results look off.
OPENAI_VISION_DETAIL=low

# Public site URL — used for canonical URLs, sitemap, robots and OG tags.
# Set to your production domain when you deploy (e.g. https://dekhlo.pk).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — publishable client (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase — server-only secret key (never expose to the browser).
SUPABASE_SECRET_KEY=your-secret-key

# Optional — protects GET /api/health/supabase outside development.
# INTERNAL_HEALTH_SECRET=

# Upstash Redis — server-only rate limiting for demo and public try-on routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only pepper for hashing client IPs in lead capture rate limits (required in production).
LEAD_RATE_LIMIT_HASH_SECRET=

# Demo abuse controls — server-only.
DEMO_KILL_SWITCH=false
DEMO_DAILY_CAP=500

# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
